generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. USER, IDENTITY & CREATOR PROFILES
// ==========================================

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  phone            String?       @unique
  name             String?
  passwordHash     String?
  role             Role          @default(STUDENT)
  isVerified       Boolean       @default(false)
  
  // Account Lifecycle Control
  accountStatus    AccountStatus @default(ACTIVE)
  deactivatedAt    DateTime?     
  statusReason     String?       

  gatewayProfileId String?
  oauthAccounts    OAuthAccount[]
  
  // Base Relations
  subscriptions    Subscription[]
  testAttempts     TestAttempt[]
  leaderboards     Leaderboard[]

  // Creator CRM & Marketplace Relations
  creatorProfile     CreatorProfile?
  following          CreatorFollower[] @relation("StudentFollowing")
  followers          CreatorFollower[] @relation("CreatorFollowers")
  
  // Content Ownership (Multi-Tenancy)
  createdCollections Collection[]      @relation("CreatorCollections")
  createdTests       Test[]            @relation("CreatorTests")
  createdQuestions   Question[]        @relation("CreatorQuestions")
  createdProducts    Product[]         @relation("CreatorProducts")
  createdCoupons     Coupon[]          @relation("CreatorCoupons")
  
  // Financial Ledger
  purchasesMade      Transaction[]     @relation("StudentPurchases")
  salesReceived      Transaction[]     @relation("CreatorSales")

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([email])
  @@index([phone])
  @@index([accountStatus])
}

enum Role {
  STUDENT
  CONTENT_CREATOR
  ADMIN
  SUPERADMIN
}

enum AccountStatus {
  ACTIVE
  DEACTIVATED_BY_USER
  SUSPENDED_BY_ADMIN
}

model CreatorProfile {
  id             String        @id @default(uuid())
  userId         String        @unique
  slug           String        @unique // e.g., "sharma-math-academy"
  brandName      String        
  bio            String?       @db.Text
  logoUrl        String?
  bannerUrl      String?
  // NEW: KYC & Onboarding Fields
  legalName       String?  // Needed for bank matching
  kycDocumentType String?  // e.g., "AADHAAR", "PAN", "PASSPORT"
  kycDocumentNum  String?  @unique // Encrypted or masked in UI
  isKycVerified   Boolean  @default(false)
  // Legal & Compliance (Copyright Protection)
  acceptedCopyrightPolicyAt DateTime?  // Timestamp of when they agreed to the terms
  status                    CreatorStatus @default(PENDING) // Admin approval workflow
  // NEW: Razorpay Route Account ID (e.g., "acc_JM23xyz")
  razorpayAccountId String? @unique
  // Dynamic Commission Rate (Default 20% platform fee)
  commissionRate Decimal       @default(20.00) @db.Decimal(5, 2) 

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([slug])
  @@index([status])
}

enum CreatorStatus {
  PENDING    // Waiting for admin approval
  ACTIVE     // Live on the marketplace
  SUSPENDED  // Banned due to copyright strike or fraud
  REJECTED   // Initial application denied
}

model CreatorFollower {
  id        String   @id @default(uuid())
  studentId String
  creatorId String

  student   User     @relation("StudentFollowing", fields: [studentId], references: [id], onDelete: Cascade)
  creator   User     @relation("CreatorFollowers", fields: [creatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([studentId, creatorId]) 
  @@index([creatorId])
}

model OAuthAccount {
  id             String   @id @default(uuid())
  userId         String
  provider       String   
  providerUserId String
  accessToken    String?  @db.Text
  refreshToken   String?  @db.Text
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Otp {
  id        String   @id @default(uuid())
  email     String
  code      String
  used      Boolean  @default(false)
  type      String   
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

// ==========================================
// 2. MONETIZATION & B2B2C FINANCIAL LEDGER
// ==========================================

model Product {
  id            String   @id @default(uuid())
  name          String 
  slug          String   @unique
  description   String?  @db.Text
  price         Decimal  @db.Decimal(10, 2)
  discountPrice Decimal? @db.Decimal(10, 2)
  validityDays  Int 
  isActive      Boolean  @default(true)
  features      Json? 
  
  // Multi-Tenancy (Owner of this product)
  creatorId     String?  // Null means PrepMaster Official Product
  creator       User?    @relation("CreatorProducts", fields: [creatorId], references: [id], onDelete: SetNull)
  
  entitlements  ProductEntitlement[]
  subscriptions Subscription[]
  coupons       Coupon[] 
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
  @@index([creatorId])
}

model Coupon {
  id            String       @id @default(uuid())
  code          String       @unique 
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(10, 2) 
  
  maxUses       Int?         
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  expiresAt     DateTime?

  // Restrict coupon to a specific creator or product
  creatorId     String?      
  productId     String?      

  creator       User?        @relation("CreatorCoupons", fields: [creatorId], references: [id], onDelete: Cascade)
  product       Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  createdAt     DateTime     @default(now())
  
  @@index([code])
  @@index([creatorId])
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model ProductEntitlement {
  id           String      @id @default(uuid())
  productId    String
  collectionId String?     
  testId       String?     
  
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  test         Test?       @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([collectionId])
  @@index([testId])
}

model Subscription {
  id           String             @id @default(uuid())
  userId       String
  productId    String
  status       SubscriptionStatus @default(ACTIVE)
  
  startDate    DateTime           @default(now())
  endDate      DateTime
  
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id], onDelete: Restrict)
  transactions Transaction[]

  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([userId, status, endDate]) 
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELED
}

// Immutable Financial Ledger
model Transaction {
  id                 String            @id @default(uuid())
  userId             String            
  subscriptionId     String?
  
  currency           String            @default("INR")
  status             TransactionStatus @default(PENDING)
  gatewayReferenceId String            @unique 
  
  // Ledger Math
  baseAmount         Decimal           @db.Decimal(10, 2) 
  discountApplied    Decimal?          @db.Decimal(10, 2) 
  finalAmount        Decimal           @db.Decimal(10, 2) 
  
  // Revenue Split (Calculated from finalAmount)
  creatorId          String?           // Null = PrepMaster Official Sale
  platformShare      Decimal?          @db.Decimal(10, 2) 
  creatorShare       Decimal?          @db.Decimal(10, 2) 
  
  couponId           String?

  user               User              @relation("StudentPurchases", fields: [userId], references: [id], onDelete: Cascade)
  creator            User?             @relation("CreatorSales", fields: [creatorId], references: [id], onDelete: SetNull)
  subscription       Subscription?     @relation(fields: [subscriptionId], references: [id])
  coupon             Coupon?           @relation(fields: [couponId], references: [id])

  createdAt          DateTime          @default(now())

  @@index([userId, status])
  @@index([creatorId, status]) 
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// ==========================================
// 3. CONTENT GRAPH & MULTI-TENANCY
// ==========================================

model Collection {
  id            String          @id @default(uuid())
  name          String 
  slug          String          @unique
  type          CollectionType 
  
  creatorId     String?  
  creator       User?           @relation("CreatorCollections", fields: [creatorId], references: [id], onDelete: SetNull)

  parentId      String?
  parent        Collection?     @relation("CollectionHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children      Collection[]    @relation("CollectionHierarchy")
  
  tests         CollectionTest[]
  entitlements  ProductEntitlement[]
  
  isPublished   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([parentId])
  @@index([type])
  @@index([creatorId])
}

enum CollectionType {
  ROOT_CATEGORY 
  EXAM          
  TEST_SERIES   
  SUBJECT_BUNDLE
}

model CollectionTest {
  collectionId String
  testId       String
  order        Int        @default(0) 
  
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  test         Test       @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@id([collectionId, testId])
  @@index([testId])
}

model Test {
  id                 String             @id @default(uuid())
  title              String
  slug               String             @unique
  type               TestType           @default(FULL_MOCK)
  
  creatorId          String?  
  creator            User?              @relation("CreatorTests", fields: [creatorId], references: [id], onDelete: SetNull)

  totalDuration      Int                
  totalMarks         Int
  availableLanguages String[]           
  calculatorType     Calculator         @default(NONE)
  strictNavigation   Boolean            @default(false) 
  
  liveStartTime      DateTime?
  liveEndTime        DateTime?
  
  collections        CollectionTest[]
  entitlements       ProductEntitlement[] 
  
  sections           TestSection[]
  attempts           TestAttempt[]
  leaderboards       Leaderboard[]
  
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([type])
  @@index([creatorId])
}

enum TestType {
  FULL_MOCK
  SECTIONAL
  TOPIC
  PREVIOUS_YEAR
  LIVE
}

enum Calculator {
  NONE
  BASIC
  SCIENTIFIC
}

// ==========================================
// 4. QUESTION BANK (SILOED IP PROTECTION)
// ==========================================

model TestSection {
  id            String         @id @default(uuid())
  testId        String
  name          String         
  duration      Int?           
  order         Int
  cutoffMarks   Decimal?       @db.Decimal(6, 2)
  
  test          Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  testQuestions TestQuestion[] 

  @@index([testId])
}

model QuestionContext {
  id         String     @id @default(uuid())
  title      String?    
  content    Json       
  mediaUrls  String[]
  questions  Question[] 
  
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Question {
  id              String           @id @default(uuid())
  
  creatorId       String?          
  creator         User?            @relation("CreatorQuestions", fields: [creatorId], references: [id], onDelete: SetNull)

  subject         String           
  topic           String           
  difficulty      Difficulty       @default(MEDIUM)
  type            QuestionType     @default(SINGLE_CHOICE)
  mediaUrls       String[]
  
  contextId       String?
  context         QuestionContext? @relation(fields: [contextId], references: [id], onDelete: SetNull)
  
  content         Json             
  solution        Json?            
  
  options         Option[]
  testOccurrences TestQuestion[]
  
  createdAt       DateTime         @default(now())

  @@index([subject, topic])
  @@index([creatorId])
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  NUMERIC_INPUT
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  content    Json     
  isCorrect  Boolean  @default(false)
  order      Int
  
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model TestQuestion {
  id            String       @id @default(uuid())
  sectionId     String
  questionId    String
  order         Int
  
  marks         Decimal      @db.Decimal(4, 2) 
  negativeMarks Decimal      @db.Decimal(4, 2) 
  
  section       TestSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  question      Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answers       UserAnswer[]
  
  @@unique([sectionId, order])
  @@index([questionId])
}

// ==========================================
// 5. ATTEMPT & ANALYTICS
// ==========================================

model TestAttempt {
  id            String        @id @default(uuid())
  userId        String
  testId        String
  status        AttemptStatus
  testMode      AttemptMode   @default(PRACTICE) 
  
  startedAt     DateTime      @default(now())
  submittedAt   DateTime?
  
  score         Decimal?      @db.Decimal(6, 2)
  accuracy      Decimal?      @db.Decimal(5, 2)
  percentile    Decimal?      @db.Decimal(5, 2)
  timeSpent     Int?          
  
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  test          Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  answers       UserAnswer[]
  
  @@index([userId, testId, status])
  @@index([testId, testMode])
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EVALUATED
  ABANDONED
}

enum AttemptMode {
  PRACTICE
  LIVE_LEADERBOARD
}

model UserAnswer {
  id                String        @id @default(uuid())
  attemptId         String
  testQuestionId    String
  
  state             QuestionState @default(UNVISITED)
  selectedOptionIds String[]      
  textResponse      String?       
  
  timeTakenSec      Int           @default(0)
  isCorrect         Boolean?
  marksAwarded      Decimal?      @db.Decimal(4, 2)
  
  attempt           TestAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  testQuestion      TestQuestion  @relation(fields: [testQuestionId], references: [id])

  @@unique([attemptId, testQuestionId])
  @@index([attemptId, state])
}

enum QuestionState {
  UNVISITED
  SKIPPED              
  ANSWERED             
  MARKED_FOR_REVIEW    
  ANSWERED_AND_MARKED  
}

model Leaderboard {
  id         String   @id @default(uuid())
  testId     String
  userId     String
  score      Decimal  @db.Decimal(6, 2)
  rank       Int
  percentile Decimal  @db.Decimal(5, 2)
  
  test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([testId, userId])
  @@index([testId, rank])
}